// ═══════════════════════════════════════════════════════════════════════════════
// Store-Specific Schema — Each store gets its own PostgreSQL schema
// All models here are per-store (no storeId needed)
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/store-client"
}

datasource db {
  provider = "postgresql"
  url      = env("STORE_DATABASE_URL")
}

// ─── Branch (Chi nhánh) ────────────────────────────────────────────────────────

model Branch {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  isMainBranch Boolean  @default(false)
  address      String?
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

// ─── Users (store-local) ───────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  password         String
  role             String    @default("cashier")
  phone            String?
  avatar           String?
  code             String?   @unique
  salary           Float?
  hireDate         DateTime?
  shifts           Int       @default(0)
  totalSales       Float     @default(0)
  employeeStatus   String    @default("active")
  notes            String?
  isLocked         Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  trustedDevices   String    @default("[]") // JSON: [{id,name,browser,os,ip,lastUsed,createdAt}]
  permissions      String    @default("[]") // JSON: granular permission list per employee
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions          Transaction[]
  inventoryTransactions InventoryTransaction[]
  importReceipts        ImportReceipt[]
  apiKeys               ApiKey[]
  salesCheckins         SalesCheckin[]
  salesOrders           SalesOrder[]

  @@index([branchId])
  @@index([role])
  @@index([employeeStatus])
}

// ─── API Keys ──────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyId      String    @unique
  secretHash String
  lastFour   String
  scopes     String    @default("read")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
}

// ─── Outbound Webhooks (đầu ra: đẩy sự kiện hàng hóa/tồn kho ra hệ thống ngoài) ──

model WebhookEndpoint {
  id           String    @id @default(cuid())
  url          String
  secret       String // dùng ký HMAC-SHA256 header X-Webhook-Signature
  events       String    @default("[]") // JSON array: ["stock.changed","product.updated",...]
  description  String?
  isActive     Boolean   @default(true)
  failureCount Int       @default(0) // số lần giao thất bại liên tiếp (auto-disable khi quá cao)
  lastStatus   String? // tóm tắt lần giao gần nhất
  lastFiredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType    String
  payload      String // JSON body đã ký
  status       String          @default("pending") // pending | sending | success | failed | dead
  attempts     Int             @default(0)
  maxAttempts  Int             @default(6)
  nextRetryAt  DateTime?
  responseCode Int?
  lastError    String?
  createdAt    DateTime        @default(now())
  deliveredAt  DateTime?

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@index([createdAt])
}

// ─── Sales Staff Tracking ───────────────────────────────────────────────────

model SalesCheckin {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  type         String
  latitude     Float
  longitude    Float
  address      String?
  note         String?
  photo        String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([customerId])
}

// ─── Products ──────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  color       String?
  level       Int        @default(1)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime   @default(now())

  products Product[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  barcode      String?
  description  String?
  categoryId   String
  brandId      String?
  productType  String   @default("goods") // "goods" | "service"
  costPrice    Float    @default(0)
  sellingPrice Float    @default(0)
  taxInclusive Boolean  @default(false)
  stock        Int      @default(0)
  minStock     Int      @default(0)
  maxStock     Int      @default(0)
  baseUnit     String   @default("cái")
  // ĐVT ghi trên HOÁ ĐƠN ĐIỆN TỬ khi khác đơn vị gốc: nhập theo vỉ/thùng thì hoá
  // đơn đầu ra cũng phải ghi theo vỉ/thùng cho khớp chứng từ đầu vào, trong khi
  // kho và sàn (Shopee/TikTok) vẫn chạy theo đơn vị gốc là cái.
  invoiceUnit  String?
  // Sản phẩm này THỰC CHẤT LÀ COMBO: bán 1 cái = xuất N mặt hàng thành phần.
  // Đơn về sẽ tự bung thành từng thành phần → kho trừ đúng từng mã, tồn kho thuế
  // đúng từng mã, và HOÁ ĐƠN XUẤT TỪNG SẢN PHẨM thay vì 1 dòng combo.
  bundleId     String?
  // ĐÃ GỘP vào mã khác: giữ NGUYÊN mã cũ (đổi mã sẽ làm gãy đẩy tồn lên sàn vì
  // sàn dò theo SKU), chỉ trỏ sang mã đích kèm hệ số quy đổi. Mọi đường (đơn về,
  // đẩy tồn) đều đi theo con trỏ này.
  mergedIntoId String?
  mergedRate   Float    @default(1)
  trackSerial  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category           Category               @relation(fields: [categoryId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  unitConversions    UnitConversion[]
  images             ProductImage[]
  transactionItems   TransactionItem[]
  inventoryTx        InventoryTransaction[]
  importReceiptItems ImportReceiptItem[]
  salesOrderItems    SalesOrderItem[]
  serials            ProductSerial[]
  onlineOrderItems   OnlineOrderItem[]
  onlineProducts     OnlineProduct[]
  skuMappings        SkuMapping[]

  @@index([categoryId])
  @@index([brandId])
  @@index([barcode])
  @@index([productType])
}

model ProductSerial {
  id        String    @id @default(cuid())
  productId String
  serial    String
  status    String    @default("in_stock")
  soldAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, serial])
  @@index([productId])
  @@index([serial])
  @@index([status])
}

model UnitConversion {
  id             String @id @default(cuid())
  productId      String
  fromUnit       String
  toUnit         String
  conversionRate Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Customers ─────────────────────────────────────────────────────────────────

model CustomerGroup {
  id       String @id @default(cuid())
  name     String
  discount Float  @default(0)
  color    String @default("#6b7280")

  customers Customer[]
}

model Customer {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  phone            String
  email            String?
  address          String?
  latitude         Float? // Vĩ độ — lưu sau khi geocode địa chỉ
  longitude        Float? // Kinh độ — lưu sau khi geocode địa chỉ
  groupId          String?
  birthday         String?
  gender           String?
  notes            String?
  salesUserId      String? // NV Sales phụ trách
  salesUserName    String? // Tên NV Sales (denormalized)
  totalPurchases   Float     @default(0)
  totalOrders      Int       @default(0)
  debt             Float     @default(0)
  loyaltyPoints    Int       @default(0)
  tier             String    @default("bronze")
  lastPurchaseDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group         CustomerGroup? @relation(fields: [groupId], references: [id])
  transactions  Transaction[]
  salesCheckins SalesCheckin[]
  salesOrders   SalesOrder[]

  @@index([groupId])
  @@index([phone])
  @@index([tier])
  @@index([salesUserId])
}

// ─── Transactions ──────────────────────────────────────────────────────────────

model Transaction {
  id                  String    @id @default(cuid())
  receiptNumber       String    @unique
  customerId          String?
  customerName        String?
  customerPhone       String?
  branchId            String?
  subtotal            Float     @default(0)
  discount            Float     @default(0)
  discountType        String?   @default("fixed")
  tax                 Float     @default(0)
  total               Float     @default(0)
  amountReceived      Float     @default(0)
  change              Float     @default(0)
  status              String    @default("completed")
  createdBy           String
  createdByName       String?
  notes               String?
  returnedAt          DateTime?
  returnReason        String?
  transactionDate     DateTime?
  vatInvoiceNumber    String?
  vatIssuedAt         DateTime?
  vatStatus           String    @default("none")
  vatBuyerInfo        String? // JSON {name,taxCode,address,email} khách yêu cầu xuất HĐ — có là cron tự xuất khi giao xong + gửi email
  revisionOfId        String? // If this is a revision, points to the original transaction
  appliedPromotionIds String? // JSON array of Promotion.id values applied at checkout
  channel             String    @default("direct") // direct | van | delivery | online
  createdAt           DateTime  @default(now())

  creator  User              @relation(fields: [createdBy], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  items    TransactionItem[]
  payments Payment[]

  @@index([branchId])
  @@index([createdAt])
  @@index([status])
  @@index([customerId])
  @@index([createdBy])
}

model TransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  productId     String
  productName   String
  sku           String
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0)
  discountType  String? @default("fixed")
  lineTotal     Float
  // Số lượng đã trừ kho theo ĐƠN VỊ GỐC (quantity × conversionRate lúc bán).
  // 0 = bản ghi cũ chưa có dữ liệu → khi hoàn kho fallback về quantity.
  baseQuantity  Float   @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
}

model Payment {
  id            String  @id @default(cuid())
  transactionId String
  type          String
  amount        Float
  reference     String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

// ─── Inventory ─────────────────────────────────────────────────────────────────

model InventoryTransaction {
  id              String    @id @default(cuid())
  type            String
  productId       String
  productName     String
  productSku      String
  quantity        Int
  reason          String
  note            String?
  referenceId     String?
  referenceType   String?
  unitPrice       Float?
  costPriceAfter  Float?
  supplierId      String?
  supplierName    String?
  branchId        String?
  userId          String?
  userName        String
  transactionDate DateTime?
  createdAt       DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([referenceType])
}

model ImportReceipt {
  id              String    @id @default(cuid())
  code            String    @unique
  supplierId      String?
  supplierName    String?
  totalCost       Float     @default(0)
  totalItems      Int       @default(0)
  status          String    @default("draft")
  // Công nợ NCC: số đã trả + trạng thái thanh toán. Mặc định "paid" để phiếu
  // nhập cũ (trước khi có tracking) không bị tính thành nợ ảo trong báo cáo.
  paidAmount      Float     @default(0)
  paymentStatus   String    @default("paid") // "paid" | "partial" | "unpaid"
  dueDate         DateTime? // hạn trả nợ NCC (ngày cụ thể, tính từ điều khoản)
  paymentTerm     String? // điều khoản TT dạng nhãn (vd "Sau 30 ngày", "Cuối tháng sau")
  // Có HOÁ ĐƠN GTGT (VAT) đầu vào hay không — CHỈ phiếu này mới tính vào TỒN KHO
  // THUẾ (gate xuất HĐ). Nhập từ file HĐĐT (XML/PDF) tự bật; nhập tay có tick.
  hasVatInvoice   Boolean   @default(false)
  vatInvoiceNo    String?
  // Chi phí cấp PHIẾU — phân bổ vào GIÁ VỐN theo tỷ trọng thành tiền từng dòng
  // (giá vốn = giá nhập + phân bổ chi phí; giá nhập trên dòng giữ nguyên giá HĐ)
  vatAmount       Float     @default(0)
  shippingFee     Float     @default(0)
  importTax       Float     @default(0)
  otherFees       Float     @default(0)
  totalDiscount   Float     @default(0)
  note            String?
  branchId        String?
  userId          String
  userName        String
  transactionDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User                @relation(fields: [userId], references: [id])
  items ImportReceiptItem[]

  @@index([branchId])
  @@index([supplierId])
  @@index([createdAt])
  @@index([status])
}

model ImportReceiptItem {
  id               String @id @default(cuid())
  receiptId        String
  productId        String
  productName      String
  productSku       String
  quantity         Int
  returnedQuantity Int    @default(0)
  costPrice        Float
  discount         Float  @default(0)
  total            Float

  receipt ImportReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

// ─── Promotions ────────────────────────────────────────────────────────────────

model Promotion {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  type          String
  value         Float
  minOrderValue Float?
  maxDiscount   Float?
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active")
  usageCount    Int      @default(0)
  usageLimit    Int?
  applicableTo  String   @default("all")
  categoryIds   String?
  productIds    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Suppliers ─────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxCode     String?
  totalOrders Int      @default(0)
  totalValue  Float    @default(0)
  status      String   @default("active")
  notes       String?
  payable     Float    @default(0) // công nợ phải trả NCC (số dư đầu kỳ + phát sinh)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

// ─── Purchase Orders ───────────────────────────────────────────────────────────

model PurchaseOrder {
  id            String    @id @default(cuid())
  code          String    @unique
  supplierId    String?
  supplierName  String
  status        String    @default("draft")
  totalAmount   Float     @default(0)
  notes         String?
  expectedDate  DateTime?
  receivedDate  DateTime?
  // Cổng kiểm hàng (2026-08-04): hàng về ở trạng thái "checking", NGƯỜI KIỂM
  // chấp nhận phiếu (→received) thì kho mới được ghi. Ai duyệt phải để lại tên.
  checkedBy     String?
  checkedByName String?
  checkedAt     DateTime?
  rejectReason  String?
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([branchId])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productName     String
  sku             String?
  quantity        Int
  unitPrice       Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

// ─── Expenses ──────────────────────────────────────────────────────────────────

model Expense {
  id               String    @id @default(cuid())
  description      String
  amount           Float
  category         String
  date             DateTime  @default(now())
  paidBy           String?
  recurring        Boolean   @default(false)
  bankAccountId    String?
  // "pending" = bóc tự động từ email HĐĐT, CHỜ DUYỆT — thống kê chỉ tính
  // "active" nên phiếu chờ không lọt vào sổ trước khi người dùng xem (2026-08-05)
  status           String    @default("active") // "active" | "pending" | "cancelled"
  // ─── Hoá đơn đầu vào (VAT khấu trừ) ───────────────────────────────────────
  // Mất số hoá đơn / MST người bán là mất quyền khấu trừ, nên giữ đủ ngay từ
  // lúc bóc thư, không để người dùng nhập lại tay.
  vatAmount        Float?
  supplierName     String?
  supplierTaxCode  String?
  invoiceNo        String?
  invoiceSymbol    String?
  invoiceDate      DateTime?
  lookupCode       String? // mã tra cứu trên cổng HĐĐT của NCC
  taxAuthorityCode String? // mã của cơ quan thuế
  sourceRef        String? // khoá chống trùng: MST bán|ký hiệu|số HĐ
  cancelledAt      DateTime?
  cancelReason     String?
  branchId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([branchId])
  @@index([status])
}

// ─── Cash Receipts ─────────────────────────────────────────────────────────────

model CashReceipt {
  id            String    @id @default(cuid())
  description   String
  amount        Float
  category      String // "debt_collection" | "rental" | "capital" | "refund" | "other"
  date          DateTime  @default(now())
  receivedVia   String? // "Tiền mặt" | "Chuyển khoản"
  bankAccountId String?
  customerId    String?
  customerName  String?
  reference     String?
  status        String    @default("active") // "active" | "cancelled"
  cancelledAt   DateTime?
  cancelReason  String?
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([branchId])
  @@index([date])
  @@index([bankAccountId])
  @@index([status])
}

// ─── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}

// ─── Warranty ──────────────────────────────────────────────────────────────────

model Warranty {
  id            String   @id @default(cuid())
  code          String   @unique
  productId     String?
  productName   String
  customerName  String
  customerPhone String?
  serialNumber  String?
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active")
  transactionId String? // Linked to the transaction that created this warranty
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Repairs ───────────────────────────────────────────────────────────────────

model Repair {
  id            String    @id @default(cuid())
  code          String    @unique
  productName   String
  customerName  String
  customerPhone String?
  issue         String
  status        String    @default("received")
  cost          Float     @default(0)
  estimatedDate DateTime?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Quotations ────────────────────────────────────────────────────────────────

model Quotation {
  id            String    @id @default(cuid())
  code          String    @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  items         String
  subtotal      Float     @default(0)
  discount      Float     @default(0)
  totalAmount   Float     @default(0)
  status        String    @default("draft")
  validUntil    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  deviceInfo String? // JSON: {browser, os, ip, deviceId}
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}

// ─── Price History ─────────────────────────────────────────────────────────────

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  productName String
  productSku  String?
  oldPrice    Float
  newPrice    Float
  changedBy   String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ─── Shipping ──────────────────────────────────────────────────────────────────

model ShippingOrder {
  id             String    @id @default(cuid())
  code           String    @unique
  transactionId  String?
  customerName   String
  customerPhone  String?
  address        String
  driverId       String?
  driverName     String?
  vehicleId      String?
  vehiclePlate   String?
  carrier        String    @default("self")
  trackingNumber String?
  status         String    @default("preparing")
  shippingFee    Float     @default(0)
  cod            Float     @default(0)
  notes          String?
  estimatedDate  DateTime?
  deliveredDate  DateTime?
  branchId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([transactionId])
  @@index([vehicleId])
  @@index([branchId])
}

// ─── Drivers ───────────────────────────────────────────────────────────────────

model Driver {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  phone           String
