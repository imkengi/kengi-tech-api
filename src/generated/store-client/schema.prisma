// ─── Store Settings (replaces Store model for local config) ─────────────────

/// Ánh xạ MÃ HÀNG TRÊN SÀN → sản phẩm trong kho. Đơn Shopee/TikTok hay dùng mã
/// riêng (vd "Ct30plus", "cs24") không trùng SKU kho → orderSync bỏ qua, đơn
/// không lên phiếu ⇒ không xuất được hoá đơn. Bảng này để map thủ công 1 lần.
/// platform = null: áp cho mọi sàn. Khớp KHÔNG phân biệt hoa thường.
model SkuMapping {
  id             String   @id @default(cuid())
  platformSku    String
  productId      String
  platform       String?
  note           String?
  // Hệ số quy đổi: 1 đơn vị ở NGUỒN (dòng hoá đơn / SKU sàn) = bao nhiêu đơn vị
  // GỐC của sản phẩm kho. VD hoá đơn ghi "5 vỉ" mà kho đếm theo cái, vỉ 10 cái
  // → rate = 10 → nhập vào kho 50 cái, đơn giá chia 10.
  conversionRate Float    @default(1)
  // Ánh xạ tới COMBO thay vì 1 sản phẩm: SKU sàn là combo N món → khi đơn về tự
  // bung thành từng thành phần để trừ kho và tính tồn kho thuế cho đúng từng mã.
  bundleId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([platformSku, platform])
  @@index([productId])
}

// Doanh thu GHI CHÉP TAY của HKD (sổ S2b) — bán chợ/tiền mặt chưa lên hoá đơn.
// Route /api/tax/hkd-revenue đã dùng model này từ lâu nhưng schema THIẾU → mọi
// request 500 "Cannot read properties of undefined (reading 'findMany')".
model HkdRevenueEntry {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  soChungTu     String?
  dienGiai      String
  doanhThu      Float    @default(0)
  chietKhau     Float    @default(0)
  thueGTGT      Float    @default(0)
  doanhThuThuan Float    @default(0)
  tncnUocTinh   Float    @default(0)
  phuongThucTT  String   @default("Tiền mặt")
  ghiChu        String?
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([branchId])
}

model StoreSettings {
  id                 String  @id @default("default")
  name               String
  address            String?
  phone              String?
  logo               String?
  description        String?
  costPriceMethod    String  @default("fixed")
  trackSerial        Boolean @default(false)
  trackBatch         Boolean @default(false)
  allowNegativeStock Boolean @default(false)
  shiftConfig        String?
  businessType       String  @default("company")
  taxCode            String?
  ownerName          String?
  ownerIdNumber      String?
  representativeName String?
  email              String?
  website            String?
  notifyLowStock     Boolean @default(true)

  // SMTP email công ty cho CRM gửi email chào hàng — JSON {host,port,user,pass,fromName,secure}
  smtpConfig    String?
  // Hộp thư Gmail RIÊNG để check trong app (04/08/2026) — TÁCH khỏi smtpConfig
  // (mail gửi CRM là tài khoản khác). JSON {user, pass, host?}
  mailboxConfig String?

  // Key Gemini riêng của cửa hàng cho Trợ lý AI (chỉ admin cấu hình; API che dạng ••••).
  geminiApiKey String?

  notifyNewOrder Boolean @default(true)

  notifyDailyReport Boolean @default(false)

  notifyWeeklyReport Boolean @default(true)

  autoRestockOnReturn Boolean @default(true)

  // Auto-generate JournalEntry records on POS transaction completion (Sales + VAT + COGS).
  // When false, accountants must run POST /api/tax/auto-journal manually to backfill.
  autoCreateJournalEntries Boolean @default(true)

  // Permission: allow Sales role to checkout/sell directly. When false, Sales can only create SalesOrder
  salesCanCheckout Boolean @default(false)

  // Store hours - "HH:mm" 24h format
  openTime  String?
  closeTime String?

  // Sales targets
  dailyRevenueTarget   Float?
  monthlyRevenueTarget Float?
  dailyOrderTarget     Int?

  // Google Drive folder ID for packing/return-unbox videos
  driveFolderId   String?
  // Kết nối Google Drive BẰNG TÀI KHOẢN CHỦ SHOP (OAuth). Cần vì file trong
  // My Drive chỉ CHỦ SỞ HỮU xoá được — service account dù có quyền Editor vẫn
  // bị Google chặn, nên dọn video tự động phải chạy dưới danh nghĩa chính chủ.
  driveOauthToken String? // refresh_token (dài hạn)
  driveOauthEmail String? // email tài khoản đã kết nối, để hiện trên giao diện
  driveOauthAt    DateTime?

  updatedAt DateTime @updatedAt
}

