  netSalary    Float     @default(0)
  totalCost    Float     @default(0)
  dependents   Int       @default(0)
  status       String    @default("draft")
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([employeeId])
}

// ─── Tiền lương Phase 4 (Employee + PayrollPeriod + PayrollEntry) ───────────

model Employee {
  id                String   @id @default(cuid())
  code              String
  name              String
  position          String?
  department        String?
  baseSalary        Float    @default(0)
  bankAccount       String?
  bankName          String?
  taxCode           String?
  socialInsuranceNo String?
  startDate         String?
  endDate           String?
  status            String   @default("active")
  dependents        Int      @default(0)
  notes             String?
  branchId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([code])
  @@index([branchId])
}

model PayrollPeriod {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  status          String    @default("draft")
  totalGross      Float     @default(0)
  totalDeductions Float     @default(0)
  totalNet        Float     @default(0)
  notes           String?
  branchId        String?
  createdBy       String?
  confirmedAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([year, month])
  @@index([branchId])
}

model PayrollEntry {
  id                      String   @id @default(cuid())
  periodId                String
  employeeId              String
  employeeCode            String?
  employeeName            String?
  workDays                Float    @default(0)
  baseSalary              Float    @default(0)
  allowances              Float    @default(0)
  overtimePay             Float    @default(0)
  grossSalary             Float    @default(0)
  bhxhEmployee            Float    @default(0)
  bhytEmployee            Float    @default(0)
  bhtnEmployee            Float    @default(0)
  bhxhEmployer            Float    @default(0)
  bhytEmployer            Float    @default(0)
  bhtnEmployer            Float    @default(0)
  totalInsuranceEmployee  Float    @default(0)
  totalInsuranceEmployer  Float    @default(0)
  totalInsuranceDeduction Float    @default(0)
  taxableIncome           Float    @default(0)
  personalDeduction       Float    @default(0)
  dependentDeduction      Float    @default(0)
  dependents              Int      @default(0)
  assessableIncome        Float    @default(0)
  pitAmount               Float    @default(0)
  netSalary               Float    @default(0)
  bankTransferAmount      Float    @default(0)
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([periodId])
  @@index([employeeId])
}

// ─── Online Sales Channels ──────────────────────────────────────────────────

model OnlineChannel {
  id             String    @id @default(cuid())
  name           String
  platform       String // shopee, lazada, tiktok, website, facebook, zalo, other
  status         String    @default("active")
  shopUrl        String?
  apiKey         String?
  apiSecret      String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  shopId         String? // Shopee: shop_id; TikTok: shop_cipher (bắt buộc cho API đơn hàng)
  platformShopId String? // TikTok: shop_id dạng số — webhook gửi id này, không gửi cipher
  webhookSecret  String?
  syncEnabled    Boolean   @default(false)
  syncFromDate   DateTime? // mốc bắt đầu đồng bộ đơn (chọn lúc kết nối); sau lần sync đầu chỉ lấy gia số từ lastSyncAt + webhook
  lastSyncAt     DateTime?
  totalOrders    Int       @default(0)
  totalRevenue   Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders   OnlineOrder[]
  products OnlineProduct[]

  commissionRate Float @default(6) // % phí sàn mặc định
}

// ─── Online Orders ──────────────────────────────────────────────────────────

model OnlineOrder {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  channelId          String?
  channelName        String?
  platform           String?
  customerName       String
  customerPhone      String?
  customerEmail      String?
  shippingAddress    String?
  status             String    @default("pending") // pending, confirmed, processing, shipping, delivered, completed, cancelled, returned
  subtotal           Float     @default(0)
  discount           Float     @default(0)
  shippingFee        Float     @default(0)
  total              Float     @default(0)
  paymentMethod      String?
  paymentStatus      String    @default("unpaid") // unpaid, paid, refunded
  paidAt             DateTime?
  trackingNumber     String?
  shippingCarrier    String?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  note               String?
  internalNote       String?
  externalOrderId    String?
  externalStatus     String?
  platformFee        Float     @default(0)
  platformFeeRate    Float     @default(0)
  netRevenue         Float     @default(0)
  adsVoucherDiscount Float     @default(0) // Shopee Ads Smart Voucher — chỉ quan sát, chưa trừ netRevenue
  // Hỏa tốc (Shopee Instant Delivery — giao ≤4h): nhận diện qua logistics_channel_id
  // thuộc get_channel_list có service_type_identifier='instant'. shipByDate là HẠN
  // bàn giao ĐVVC (ship_by_date) — KHÔNG phải ngày đã gửi hàng (shippedAt).
  isInstant          Boolean   @default(false)
  shipByDate         DateTime?
  // Cờ chống trừ kho 2 lần: true khi BẤT KỲ đường nào (đổi status tay / convert
  // sync / webhook) đã trừ kho cho đơn này; hoàn kho khi hủy phải reset false.
  stockDeducted      Boolean   @default(false)
  syncedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  channel OnlineChannel?    @relation(fields: [channelId], references: [id])
  items   OnlineOrderItem[]

  @@index([channelId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([platform])
}

// ─── Online Products (Danh mục hàng hóa trên sàn) ───────────────────────────

model OnlineProduct {
  id                String    @id @default(cuid())
  channelId         String
  platform          String
  platformProductId String
  name              String
  sku               String?
  price             Float     @default(0)
  stock             Int       @default(0)
  status            String    @default("NORMAL")
  imageUrl          String?
  categoryId        String? // mã ngành hàng trên sàn (TikTok: leaf của category_chains; Shopee: category_id)
  categoryName      String? // chuỗi ngành đầy đủ "Đồ dùng nhà bếp > Dao kéo > Dao" (TikTok; Shopee chưa có tên)
  localProductId    String? // ID của Product trong kho để map Giá vốn
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  channel      OnlineChannel @relation(fields: [channelId], references: [id])
  localProduct Product?      @relation(fields: [localProductId], references: [id])

  @@unique([channelId, platformProductId]) // Mỗi gian hàng có duy nhất 1 ID này
  @@index([channelId])
  @@index([localProductId])
  @@index([platform])
}

// ─── Online Order Items ─────────────────────────────────────────────────────

model OnlineOrderItem {
  id            String  @id @default(cuid())
  onlineOrderId String
  productId     String?
  productName   String
  sku           String?
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0)
  lineTotal     Float

  onlineOrder OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([onlineOrderId])
  @@index([productId])
}

// ─── Sync Logs ──────────────────────────────────────────────────────────────

model SyncLog {
  id          String   @id @default(cuid())
  channelId   String
  action      String // sync_orders, update_status, webhook, test_connection
  status      String // success, error
  details     String?
  ordersCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([channelId, createdAt])
}

// ─── Journal Entry (Bút Toán Kế Toán) ──────────────────────────────────────

model JournalEntry {
  id                String   @id @default(cuid())
  date              String
  description       String
  debitAccount      String
  debitAccountName  String?
  creditAccount     String
  creditAccountName String?
  amount            Float
  // Khóa idempotency (SALE-/VAT-/DISC-/COGS-/COLLECT-...) — unique để 2 request
  // đồng thời không double-post; bút toán manual để null (nhiều null vẫn hợp lệ).
  reference         String?  @unique
  referenceType     String   @default("manual")
  notes             String?
  branchId          String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
  @@index([debitAccount])
  @@index([creditAccount])
  @@index([referenceType])
}

// ─── Fixed Asset (Tài Sản Cố Định) ─────────────────────────────────────────

model FixedAsset {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  category                String
  acquisitionDate         String
  originalCost            Float
  usefulLifeMonths        Int
  method                  String   @default("straight-line")
  accumulatedDepreciation Float    @default(0)
  netBookValue            Float    @default(0)
  monthlyDepreciation     Float    @default(0)
  depreciationAccount     String   @default("6424")
  residualValue           Float    @default(0)
  department              String?
  description             String?
  disposalDate            String?
  status                  String   @default("active")
  // Phase 4 (TSCĐ) — bút toán khấu hao + thanh lý theo TT99/2025
  acquisitionCost         Float    @default(0)
  depreciationMethod      String   @default("straight_line") // straight_line | declining_balance
  accountCode             String   @default("211") // 211 (hữu hình) | 213 (vô hình)
  depAccAccountCode       String   @default("2141") // 2141 | 2143 (hao mòn TSCĐ)
  expenseAccountCode      String   @default("6424") // 627 | 641 | 642
  disposalAmount          Float?
  branchId                String?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  depreciationEntries DepreciationEntry[]

  @@index([status])
  @@index([category])
  @@index([branchId])
}

// Bút toán khấu hao TSCĐ theo từng tháng.
model DepreciationEntry {
  id                      String   @id @default(cuid())
  assetId                 String
  month                   Int
  year                    Int
  beginningValue          Float    @default(0)
  depreciationAmount      Float    @default(0)
  accumulatedDepreciation Float    @default(0)
  endingValue             Float    @default(0)
  journalEntryId          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([year, month])
}

// ─── Công cụ dụng cụ (CCDC) ────────────────────────────────────────────────

model CCDC {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  category           String?
  acquisitionDate    String?
  totalValue         Float    @default(0)
  allocationMonths   Int      @default(1)
  monthlyAllocation  Float    @default(0)
  allocatedAmount    Float    @default(0)
  remainingAmount    Float    @default(0)
  accountCode        String   @default("242") // 153 | 242
  expenseAccountCode String   @default("642") // 627 | 641 | 642
  status             String   @default("allocating") // allocating | fully_allocated | disposed
  branchId           String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  allocations CCDCAllocation[]

  @@index([status])
  @@index([branchId])
}

// Bút toán phân bổ CCDC theo từng tháng.
model CCDCAllocation {
  id             String   @id @default(cuid())
  ccdcId         String
  month          Int
  year           Int
  amount         Float    @default(0)
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ccdc CCDC @relation(fields: [ccdcId], references: [id], onDelete: Cascade)

  @@index([ccdcId])
  @@index([year, month])
}

// ─── E-Invoice (Hóa đơn Điện tử) ───────────────────────────────────────────

model EInvoiceConfig {
  id                String   @id @default(cuid())
  provider          String // VNPT | VIETTEL | FPT | MISA | BKAV | EASYINVOICE | CUSTOM
  apiUrl            String?
  apiKey            String?
  apiSecret         String?
  taxCode           String?
  templateId        String?
  serialNo          String?
  active            Boolean  @default(true)
  extra             String? // JSON for provider-specific config
  // Phase 3 (TT78/2021) — credentials + company + numbering config
  apiUsername       String?
  apiPassword       String? // encrypted at rest
  companyName       String?
  companyAddress    String?
  invoicePattern    String? // mẫu số hóa đơn, e.g. "1"
  invoiceSerial     String? // ký hiệu, e.g. "C26TAA"
  certificateSerial String? // serial of the signing certificate
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Hóa đơn điện tử (TT78/2021/TT-BTC). Phase-3 model: full lifecycle
// (DRAFT → SIGNED → SENT → CANCELLED/REPLACED). Legacy provider-issuance
// fields (transactionId/provider/lookupCode/xmlData) are kept nullable for
// backward compatibility with the earlier /issue flow.
model EInvoice {
  id                  String    @id @default(cuid())
  // Legacy provider-issuance fields (now optional)
  transactionId       String?
  provider            String?
  lookupCode          String?
  xmlData             String?
  errorMessage        String?
  // Numbering / classification
  invoiceNumber       String? // số hóa đơn (sequence, e.g. 00000001)
  invoiceSymbol       String? // ký hiệu mẫu, e.g. 1C26TAA
  invoiceDate         String? // YYYY-MM-DD
  invoiceType         String    @default("SALE") // SALE | RETURN | ADJUSTMENT
  status              String    @default("DRAFT") // DRAFT|SIGNED|SENT|CANCELLED|REPLACED|ERROR
  // Seller (người bán) — auto-filled from EInvoiceConfig / StoreSettings
  sellerName          String?
  sellerTaxCode       String?
  sellerAddress       String?
  // Buyer (người mua)
  buyerName           String?
  buyerTaxCode        String?
  buyerAddress        String?
  // Totals
  totalBeforeVat      Float     @default(0)
  vatAmount           Float     @default(0)
  totalAmount         Float     @default(0)
  currency            String    @default("VND")
  paymentMethod       String? // TM | CK | TM/CK
  // Artifacts + provider linkage
  xmlContent          String? // signed XML (TT78 format)
  pdfUrl              String?
  providerInvoiceId   String? // ID returned by the e-invoice provider
  providerResponse    String? // JSON response from the provider
  // Replace / cancel trail
  replacesInvoiceId   String? // original invoice this one replaces
  replacedByInvoiceId String? // replacement invoice that supersedes this one
  // Adjust trail — HĐ điều chỉnh giảm: gốc VẪN hiệu lực nên KHÔNG dùng chung
  // hai cột replace ở trên. Cột đã có trong DB (ensureTables tự ALTER) nhưng
  // THIẾU Ở ĐÂY khiến prisma.eInvoice.create nổ "Unknown argument
  // adjustsInvoiceId" — hoá đơn phát hành xong bên VNPT mà không lưu được.
  adjustsInvoiceId    String? // hoá đơn gốc mà bản này điều chỉnh giảm
  adjustedByInvoiceId String? // bản điều chỉnh đã lập cho hoá đơn này
  adjustReturnCode    String? // mã phiếu trả đã dùng để lập bản điều chỉnh này
  cancelReason        String?
  notes               String?
  branchId            String?
  createdBy           String?
  createdByName       String?
  issuedAt            DateTime?
  signedAt            DateTime?
  sentAt              DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  items EInvoiceItem[]

  @@index([transactionId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([invoiceDate])
  @@index([buyerTaxCode])
  @@index([branchId])
}

model EInvoiceItem {
  id         String  @id @default(cuid())
  eInvoiceId String
  itemNumber Int     @default(0) // STT
  itemName   String
  unitName   String? // ĐVT
  quantity   Float   @default(0)
  unitPrice  Float   @default(0)
  vatRate    Float   @default(0) // 0 | 5 | 8 | 10 (%)
  vatAmount  Float   @default(0)
  amount     Float   @default(0) // thành tiền (chưa VAT)
  notes      String?

  eInvoice EInvoice @relation(fields: [eInvoiceId], references: [id], onDelete: Cascade)

  @@index([eInvoiceId])
}

// ─── Adjustment Invoice (Hóa đơn điều chỉnh — NĐ123/2020) ──────────────────

model AdjustmentInvoice {
  id                    String    @id @default(cuid())
  code                  String    @unique // HDDC-YYYYMMDD-NNN
  adjustmentDate        String // ngày lập hóa đơn điều chỉnh (YYYY-MM-DD)
  type                  String // "increase" | "decrease" | "info_correction"
  status                String    @default("draft") // draft | approved | cancelled
  // Original invoice reference (mandatory per NĐ123/2020 Điều 19)
  originalInvoiceId     String? // optional FK to EInvoice / Transaction if internal
  originalInvoiceNumber String
  originalInvoiceDate   String // YYYY-MM-DD
  originalInvoiceSerial String? // ký hiệu hóa đơn gốc
  // Reason (lý do điều chỉnh) — required
  reason                String
  // Buyer (người mua) — replicated on adjustment doc
  buyerName             String?
  buyerTaxCode          String?
  buyerAddress          String?
  // info_correction: capture the corrected field(s) — JSON object
  correctionData        String? // JSON: { field: { old, new } }
  // Totals (signed: positive for increase, negative for decrease, zero for info_correction)
  subtotal              Float     @default(0) // tổng tiền hàng (chưa VAT)
  vatAmount             Float     @default(0) // tổng VAT điều chỉnh
  totalAmount           Float     @default(0) // tổng cộng (đã VAT)
  notes                 String?
  // Approval/posting trail
  approvedAt            DateTime?
  approvedBy            String?
  journalEntryIds       String? // JSON array of JournalEntry ids generated on approve
  branchId              String?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items AdjustmentInvoiceItem[]

  @@index([adjustmentDate])
  @@index([type])
  @@index([status])
  @@index([originalInvoiceId])
  @@index([originalInvoiceNumber])
  @@index([branchId])
}

model AdjustmentInvoiceItem {
  id             String  @id @default(cuid())
  adjustmentId   String
  productName    String
  productCode    String?
  unit           String? // ĐVT
  quantity       Float   @default(0) // signed (negative for decrease)
  unitPrice      Float   @default(0)
  amount         Float   @default(0) // quantity * unitPrice (signed)
  vatRate        Float   @default(0) // % (0, 5, 8, 10)
  vatAmount      Float   @default(0) // signed
  adjustmentType String // "increase" | "decrease" | "info_correction"
  notes          String?

  adjustment AdjustmentInvoice @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
}

// ─── HKD Revenue Entry (Ghi chép doanh thu theo ngày) ──────────────────────

model HKDRevenueEntry {
  id            String   @id @default(cuid())
  date          DateTime
  soChungTu     String?
  dienGiai      String
  doanhThu      Float    @default(0) // Doanh thu (chưa thuế)
  chietKhau     Float    @default(0)
  thueGTGT      Float    @default(0) // GTGT tỷ lệ trực tiếp
  doanhThuThuan Float    @default(0) // Doanh thu thuần
  tncnUocTinh   Float    @default(0) // TNCN ước tính 17%
  phuongThucTT  String   @default("Tiền mặt")
  ghiChu        String?
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([branchId])
  @@index([createdAt])
}

// ─── Warehouses (Kho hàng — chính / hư hỏng / bảo hành / khác) ────────────────

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String   @default("main") // main | damaged | warranty | mobile | other
  branchId    String?
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  vehicleId   String?  @unique // when set, this warehouse is the mobile stock for a specific vehicle
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks        WarehouseStock[]
  transfersFrom StockTransfer[]  @relation("TransferFrom")
  transfersTo   StockTransfer[]  @relation("TransferTo")
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  salesTrips    SalesTrip[]

  @@index([branchId])
  @@index([type])
  @@index([isActive])
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  productName String
  productSku  String?
  quantity    Int      @default(0)
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model StockTransfer {
  id              String   @id @default(cuid())
  code            String   @unique
  fromWarehouseId String? // null = imported from main product stock
  toWarehouseId   String? // null = exported back to main product stock
  status          String   @default("completed") // draft | completed | cancelled
  reason          String? // damage | warranty_received | warranty_returned | restock | other
  notes           String?
  branchId        String?
  userId          String?
  userName        String?
  totalQuantity   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse Warehouse?          @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?          @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@index([branchId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
}

model StockTransferItem {
  id          String  @id @default(cuid())
  transferId  String
  productId   String
  productName String
  productSku  String?
  quantity    Int
  notes       String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

// ─── Sales Trips (Bán hàng lưu động trên xe) ──────────────────────────────────
// A SalesTrip orchestrates a van-sales run: pick a Vehicle, load stock from main
// into the vehicle's mobile warehouse, sell on the road, then close out and
// return any unsold stock back to main. The mobile warehouse is auto-created /
// reused per-vehicle (Warehouse.vehicleId links them 1:1).

model SalesTrip {
  id            String    @id @default(cuid())
  code          String    @unique
  vehicleId     String
  warehouseId   String
  status        String    @default("loading") // loading | active | paused | reconciling | closed | cancelled  (legacy: planned, loaded — surfaced as "loading")
  driverId      String?
  driverName    String?
  salesUserId   String
  salesUserName String?
  branchId      String?
  plannedDate   DateTime?
  startedAt     DateTime?
  pausedAt      DateTime?
  closedAt      DateTime?
  notes         String?
  totalLoaded   Int       @default(0)
  totalSold     Int       @default(0)
  totalReturned Int       @default(0)
  totalRevenue  Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  items     SalesTripItem[]
  logs      SalesTripLog[]

  @@index([vehicleId])
  @@index([warehouseId])
  @@index([status])
  @@index([branchId])
  @@index([salesUserId])
  @@index([createdAt])
}

model SalesTripItem {
  id          String  @id @default(cuid())
  tripId      String
  productId   String
  productName String
  productSku  String?
  loadedQty   Int     @default(0)
  soldQty     Int     @default(0)
  returnedQty Int     @default(0)
  actualQty   Int     @default(0)
  damagedQty  Int     @default(0)
  unitPrice   Float   @default(0)
  notes       String?

  trip SalesTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, productId])
  @@index([tripId])
  @@index([productId])
}

model SalesTripLog {
  id        String   @id @default(cuid())
  tripId    String
  action    String // create | start | pause | resume | load | unload | sale | reconcile | close | cancel
  notes     String?
  userId    String
  userName  String?
  metadata  String? // JSON string for extra data (items, quantities, etc.)
  createdAt DateTime @default(now())

  trip SalesTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
}

// ─── Inventory Count (Kiểm kê — BC26-BH hàng hóa / D02-TS TSCĐ) ─────────────

model InventoryCount {
  id            String    @id @default(cuid())
  code          String    @unique
  countDate     String // ngày kiểm kê (YYYY-MM-DD)
  type          String // "goods" | "fixed-assets"
  status        String    @default("draft") // draft | finalized | cancelled
  warehouseId   String? // optional warehouse scope (goods)
  notes         String?
  totalItems    Int       @default(0)
  surplusCount  Int       @default(0) // # items with countedQty > systemQty
  shortageCount Int       @default(0) // # items with countedQty < systemQty
  surplusValue  Float     @default(0) // total value of surplus (goods: cost; assets: NBV)
  shortageValue Float     @default(0) // total value of shortage
  finalizedAt   DateTime?
  finalizedBy   String?
  branchId      String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items InventoryCountItem[]

  @@index([countDate])
  @@index([type])
  @@index([status])
  @@index([branchId])
  @@index([warehouseId])
}

model InventoryCountItem {
  id             String  @id @default(cuid())
  countId        String
  refId          String // productId (goods) or fixedAssetId (assets)
  refCode        String? // sku / asset code (for report)
  name           String // productName / assetName
  unit           String? // ĐVT (goods only)
  systemQty      Float   @default(0) // số sổ sách (goods: stock; assets: 1)
  countedQty     Float? // số kiểm kê (nullable until counted)
  variance       Float   @default(0) // countedQty - systemQty
  unitCost       Float   @default(0) // goods: costPrice; assets: netBookValue
  originalCost   Float? // assets only: nguyên giá
  accumulatedDep Float? // assets only: khấu hao lũy kế
  netBookValue   Float? // assets only: giá trị còn lại
  condition      String? // assets: tình trạng (good | damaged | missing | disposed)
  notes          String?

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@index([refId])
}

// ─── Z-Report (Báo cáo Z — chốt ca / kết ca cuối ngày POS) ─────────────────

model ZReport {
  id             String   @id @default(cuid())
  date           DateTime // canonical day (midnight UTC) the report covers
  registerId     String // POS register / cash drawer identifier
  cashStart      Float    @default(0)
  cashEnd        Float    @default(0)
  cashSales      Float    @default(0)
  cardSales      Float    @default(0)
  totalSales     Float    @default(0)
  totalReturns   Float    @default(0)
  totalDiscounts Float    @default(0)
  netSales       Float    @default(0)
  cashDifference Float    @default(0)
  notes          String?
  branchId       String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([registerId, date])
  @@index([date])
  @@index([branchId])
  @@index([registerId])
}

// ─── Storage Vault ──────────────────────────────────────────────────────────

model StorageFile {
  id            String   @id @default(cuid())
  name          String
  url           String
  size          Int
  type          String
  category      String
  referenceId   String?
  referenceName String?
  description   String?
  uploadedBy    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([referenceId])
}

// --- Chart of Accounts (TT200/2014) ----------------------------------------

model ChartOfAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameEn      String?
  level       Int      @default(1)
  parentCode  String?
  type        String
  nature      String
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  description String?
  storeId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([parentCode])
  @@index([isActive])
}

// --- Period Lock (Khoa so ke toan) -----------------------------------------
// Locks an accounting period so vouchers dated on/before `lockDate` cannot be
// created, edited or deleted. The current lock = the most recent active row.

model PeriodLock {
  id           String    @id @default(cuid())
  lockDate     String // YYYY-MM-DD — vouchers with date <= lockDate are frozen
  periodType   String    @default("month") // month | quarter | year | custom
  note         String?
  isActive     Boolean   @default(true)
  lockedBy     String?
  lockedByName String?
  unlockedAt   DateTime?
  unlockedBy   String?
  unlockReason String?
  branchId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@index([lockDate])
  @@index([branchId])
}

// --- Exchange Rates (Multi-currency + FX revaluation) ----------------------

model ExchangeRate {
  id           String   @id @default(cuid())
  date         String
  fromCurrency String
  toCurrency   String
  rate         Float
  source       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, fromCurrency, toCurrency])
  @@index([date])
  @@index([fromCurrency])
}

// --- Tax Deadlines (Lich nop thue) ------------------------------------------

model TaxDeadline {
  id            String    @id @default(cuid())
  taxType       String
  period        String
  dueDate       String
  status        String    @default("pending")
  description   String?
  filedAt       DateTime?
  reminderSent  Boolean   @default(false)
  declarationId String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([taxType, period])
  @@index([dueDate])
  @@index([status])
  @@index([taxType])
}

// --- Tax Audit Log (Nhat ky thao tac) ---------------------------------------

model TaxAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  userName   String?
  changes    String?
  ip         String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([entityType])
  @@index([userId])
  @@index([action])
}

// --- Tax Budget (Du toan ngan sach theo tai khoan) --------------------------

model TaxBudget {
  id          String   @id @default(cuid())
  accountCode String
  year        Int
  month       Int?
  amount      Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountCode, year, month])
  @@index([year])
  @@index([accountCode])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  FANPAGE MANAGER — quản lý fanpage Facebook (lịch đăng, comment, ads)
//  Token page dài hạn (~60 ngày) lưu ở đây thay vì localStorage của trình duyệt.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Token người dùng (cho Marketing API / ads) ───────────────────────────────
// Page token KHÔNG quản lý được ads — cần user token có quyền ads_management.

model FbUserToken {
  id             String    @id @default(cuid())
  fbUserId       String    @unique // Facebook user id (chủ tài khoản ads)
  name           String?
  accessToken    String // long-lived user token (~60 ngày)
  tokenExpiresAt DateTime?
  scopes         String    @default("[]") // JSON array quyền đã cấp
  connectedBy    String? // userId nội bộ
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Kết nối Fanpage ──────────────────────────────────────────────────────────

model FbPage {
  id                String    @id @default(cuid())
  pageId            String    @unique // Facebook Page ID (số) — dùng khớp webhook
  name              String
  category          String?
  avatar            String?
  fanCount          Int       @default(0)
  accessToken       String // long-lived page access token (đổi từ user token khi kết nối)
  tokenExpiresAt    DateTime? // hạn token; cron refresh trước khi hết
  igUserId          String? // Instagram business account nối với page (nếu có)
  adAccountId       String? // act_<id> ad account mặc định để chạy ads
  webhookSubscribed Boolean   @default(false) // đã subscribe app vào page feed chưa
  autoReplyEnabled  Boolean   @default(false) // bật engine auto-reply comment cho page này
  status            String    @default("active") // active, disconnected, token_expired
  connectedBy       String? // userId người kết nối
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scheduledPosts FbScheduledPost[]
  commentRules   FbCommentRule[]
  autoReplyLogs  FbAutoReplyLog[]

  @@index([status])
}

// ─── Bài viết lên lịch (mirror trạng thái FB) ─────────────────────────────────

model FbScheduledPost {
  id           String    @id @default(cuid())
  pageId       String // FbPage.pageId
  fbPostId     String? // id post trên FB sau khi tạo (published=false)
  message      String    @default("")
  mediaType    String    @default("text") // text, photo, video, link, multi_photo
  mediaUrls    String    @default("[]") // JSON array URL ảnh/video đã upload
  linkUrl      String?
  scheduledAt  DateTime // thời điểm hẹn đăng
  status       String    @default("scheduled") // scheduled, published, failed, cancelled
  errorMessage String? // lý do nếu status=failed
  publishedAt  DateTime? // thời điểm FB thực đăng (từ reconcile)
  createdBy    String? // userId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  page FbPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@index([pageId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Rule auto-reply comment ──────────────────────────────────────────────────

model FbCommentRule {
  id           String   @id @default(cuid())
  pageId       String // FbPage.pageId
  name         String   @default("")
  keyword      String // từ khóa trigger
  matchType    String   @default("contains") // contains, exact, starts
  replyText    String // nội dung phản hồi công khai
  privateReply Boolean  @default(false) // gửi kèm private reply (Messenger)
  hideComment  Boolean  @default(false) // ẩn comment sau khi rớt rule
  enabled      Boolean  @default(true)
  priority     Int      @default(0) // rule nhỏ chạy trước (0 = cao nhất)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page FbPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@index([pageId])
  @@index([enabled])
}

// ─── Log auto-reply (chống trùng + audit) ─────────────────────────────────────

model FbAutoReplyLog {
  id           String   @id @default(cuid())
  pageId       String // FbPage.pageId
  commentId    String // id comment đã xử lý (idempotency key)
  ruleId       String? // rule đã khớp
  postId       String?
  fromName     String?
  commentMsg   String?
  action       String   @default("reply") // reply, hide, reply_hide, skipped
  replyText    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  page FbPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@unique([pageId, commentId]) // mỗi comment chỉ auto-reply 1 lần
  @@index([pageId])
  @@index([createdAt])
}

// ─── AI MARKETING: hồ sơ thương hiệu · kế hoạch nội dung · bài nháp chờ duyệt ──
// Agent tự lên content được là nhờ 3 bảng này. Không có hồ sơ thương hiệu thì
// agent chỉ viết được văn mẫu chung chung — đó là khác biệt giữa "có AI" và
// "AI viết đúng giọng shop".

model FbBrandProfile {
  id           String   @id @default(cuid())
  // MỘT hồ sơ cho cả cửa hàng (shop = thương hiệu). Code luôn dùng findFirst,
  // không tạo bản thứ hai — xem layHoSo() ở mcpMarketingTools.
  brandName    String   @default("")
  industry     String   @default("") // ngành hàng, VD "mỹ phẩm", "phụ tùng xe máy"
  audience     String   @default("") // chân dung khách: tuổi, giới, khu vực, nỗi đau
  toneOfVoice  String   @default("than-thien") // than-thien | chuyen-nghiep | hai-huoc | sang-trong
  usp          String   @default("") // vì sao khách chọn shop này chứ không phải shop khác
  cta          String   @default("") // lời kêu gọi mặc định, VD "Inbox để được tư vấn"
  hashtags     String   @default("[]") // JSON array hashtag thương hiệu
  bannedWords  String   @default("[]") // JSON array từ CẤM dùng (cam kết sai luật quảng cáo, từ nhạy cảm)
  emojiLevel   String   @default("vua") // khong | vua | nhieu
  postsPerWeek Int      @default(5)
  bestHours    String   @default("[]") // JSON array giờ VN đăng tốt, VD [8,12,20]
  pillarMix    String   @default("{}") // JSON {pillar: số bài/tuần} — giữ tỉ lệ 80/20 giá trị/bán hàng
  notes        String   @default("") // dặn dò thêm cho agent
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FbContentPlan {
  id        String   @id @default(cuid())
  pageId    String // FbPage.pageId — KHÔNG đặt FK để kế hoạch còn nguyên khi gỡ/nối lại page
  title     String
  goal      String   @default("") // mục tiêu chiến dịch, VD "đẩy hàng tồn mùa hè"
  fromDate  DateTime
  toDate    DateTime
  status    String   @default("active") // active | done | cancelled
  summary   String? // báo cáo agent viết lại sau khi lên xong kế hoạch
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts FbContentDraft[]

  @@index([pageId, status])
}

model FbContentDraft {
  id     String  @id @default(cuid())
  planId String?
  pageId String // FbPage.pageId
  pillar String  @default("khac") // trụ nội dung: giao-duc | san-pham | khuyen-mai | chung-thuc | hau-truong | tuong-tac | xu-huong | khac

  title      String  @default("") // nhãn nội bộ cho chủ shop lướt nhanh
  hook       String  @default("") // 1-2 dòng đầu — thứ quyết định khách có bấm "xem thêm" không
  message    String // TOÀN VĂN bài đăng (đã gồm hook + hashtag khi đăng)
  hashtags   String  @default("[]") // JSON array
  mediaIdea  String  @default("") // gợi ý ảnh/video cho chủ shop tự chụp nếu không dùng ảnh sẵn
  mediaUrls  String  @default("[]") // JSON array URL ảnh THẬT (lấy từ ProductImage)
  linkUrl    String?
  productIds String  @default("[]") // JSON array Product.id được nhắc tới — để truy vết bài nào đẩy hàng nào

  suggestedAt DateTime? // giờ đăng agent đề xuất (giờ VN đã quy đổi sang UTC)

  // pending = CHỜ DUYỆT (agent chỉ được dừng ở đây), scheduled = đã duyệt và lên
  // lịch thật trên Facebook, published = đã đăng, rejected = chủ shop bỏ.
  status          String  @default("pending")
  rejectReason    String?
  scheduledPostId String? // FbScheduledPost.id sau khi duyệt
  fbPostId        String?

  source    String   @default("ai") // ai | manual
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan FbContentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([pageId, status])
  @@index([suggestedAt])
  @@index([planId])
}

// ─── CRM: công việc, cơ hội bán hàng, nhật ký (kengi.vn/crm) ──────────────────
// Trước đây các mảng này chỉ nằm ở localStorage trình duyệt nên mỗi máy một dữ
// liệu. Đưa lên DB để cả đội dùng chung.

model CrmTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  customerId   String?
  customerName String?
  status       String    @default("todo") // todo | doing | done
  priority     String    @default("medium") // low | medium | high
  type         String? // call | meeting | email | visit | other
  dueDate      DateTime?
  assignee     String?
  createdBy    String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
}

model CrmDeal {
  id                String    @id @default(cuid())
  title             String
  customerId        String?
  customerName      String?
  value             Float     @default(0)
  stage             String    @default("lead") // lead | contact | demo | negotiate | won | lost
  probability       Int       @default(0)
  assignee          String?
  note              String?
  sortOrder         Int       @default(0)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@index([customerId])
  @@index([expectedCloseDate])
}

model CrmActivity {
  id          String   @id @default(cuid())
  module      String // contacts | pipeline | tasks | campaigns | debt | team | zalo | groups | email
  action      String
  description String
  userId      String?
  userName    String?
  entityId    String?
  entityName  String?
  metadata    String? // JSON tự do
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([entityId])
}

// Nhật ký Zalo tay (nhân viên ghi lại nội dung đã trao đổi với khách)
model CrmZaloLog {
  id           String   @id @default(cuid())
  customerId   String
  customerName String?
  direction    String   @default("out") // in | out
  content      String
  staffName    String?
  starred      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// Chiến dịch chăm sóc khách (email/zalo/sms)
model CrmCampaign {
  id           String    @id @default(cuid())
  name         String
  channel      String    @default("email") // email | zalo | sms
  status       String    @default("draft") // draft | scheduled | sending | sent | completed
  template     String    @default("")
  targetTiers  String    @default("[]") // JSON mảng hạng KH
  targetCount  Int       @default(0)
  sentCount    Int       @default(0)
  openRate     Float     @default(0)
  responseRate Float     @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([channel])
}

// ═══════════════════════════════════════════════════════════════════════════════
//  TRỢ LÝ AI TỰ ĐỘNG — chạy theo lịch, không cần người ngồi bấm
//  Chỉ thị viết bằng tiếng Việt; cron đánh thức Gemini kèm bộ MCP tool.
// ═══════════════════════════════════════════════════════════════════════════════

model AiAgentJob {
  id              String    @id @default(cuid())
  name            String // tên gợi nhớ, VD "Chăm bình luận sáng"
  prompt          String // chỉ thị bằng tiếng Việt cho agent
  scheduleKind    String    @default("daily") // daily | interval
  atHour          Int       @default(8) // GIỜ VIỆT NAM (không phải UTC) — cho daily
  atMinute        Int       @default(0)
  intervalMinutes Int       @default(60) // cho interval
  enabled         Boolean   @default(true)
  // An toàn: mặc định CHỈ ĐỌC. Tool ghi phải bật allowWrite, riêng tool nhạy cảm
  // (đăng bài, trả lời khách, lên đơn, thu nợ) còn phải gọi ĐÍCH DANH ở allowedTools.
  allowWrite      Boolean   @default(false)
  allowedTools    String    @default("[]") // JSON array tên tool; rỗng = mọi tool đọc
  maxSteps        Int       @default(8)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs AiAgentRun[]

  @@index([enabled, nextRunAt])
}

model AiAgentRun {
  id           String    @id @default(cuid())
  jobId        String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("running") // running | ok | error
  summary      String? // câu trả lời cuối của agent
  toolCalls    String    @default("[]") // JSON: [{name,args,ok,error}]
  steps        Int       @default(0)
  chamTran     Boolean   @default(false) // hết số bước mà chưa xong
  errorMessage String?
  trigger      String    @default("cron") // cron | manual

  job AiAgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([startedAt])
}

// ─── Cổng đồng bộ KiotViet ─────────────────────────────────────────────────
// Kéo hàng hoá/khách/NCC/hoá đơn từ KiotViet sang Kengi theo khoảng ngày, và
// nhận webhook khi bên đó phát sinh. Xem src/services/kiotvietSync.ts để nắm
// các nguyên tắc an toàn (chạy thử mặc định, không ghi đè, bất biến tồn kho).

model KiotVietConfig {
  id              String  @id @default("default")
  clientId        String
  clientSecret    String
  retailer        String // tên gian hàng, đi trong header `Retailer`
  // Token 32 byte ngẫu nhiên nằm trong ĐƯỜNG DẪN webhook — đây là lớp bảo vệ
  // CHÍNH của cổng nhận, vì công thức chữ ký của KiotViet không được công bố.
  webhookToken    String  @unique
  webhookSecret   String?
  strictSignature Boolean @default(false) // bật khi đã chốt được công thức ký

  enabled       Boolean @default(false)
  syncProducts  Boolean @default(true)
  syncCustomers Boolean @default(true)
  syncSuppliers Boolean @default(true)
  syncInvoices  Boolean @default(false) // mặc định TẮT: hoá đơn đụng doanh thu

  // Mặc định KHÔNG ghi đè dữ liệu Kengi — chỉ tạo mới và điền chỗ trống
  overwriteNames  Boolean @default(false)
  overwritePrices Boolean @default(false)
  overwriteStock  Boolean @default(false)

  defaultCategoryId  String? // nhóm hàng gán cho sản phẩm mới
  defaultWarehouseId String? // kho nhận tồn đồng bộ
  branchIds          String? // JSON mảng id chi nhánh KiotViet lấy tồn

  lastSyncAt    DateTime?
  lastWebhookAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Bản đồ id KiotViet ↔ id Kengi. Chạy lại đợt đồng bộ cũ phải ra "cập nhật"
// chứ không đẻ thêm bản ghi — bảng này là chỗ chống trùng chắc nhất.
model KiotVietMap {
  id       String   @id @default(cuid())
  entity   String // product | customer | supplier | invoice | order | category
  kvId     String
  kvCode   String?
  localId  String
  syncedAt DateTime @default(now())

  @@unique([entity, kvId])
  @@index([entity, localId])
  @@index([kvCode])
}

model KiotVietSyncLog {
  id       String    @id @default(cuid())
  entity   String
  mode     String    @default("manual") // manual | webhook
  dryRun   Boolean   @default(false)
  fromDate DateTime?
  toDate   DateTime?

  fetched Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  skipped Int @default(0)
  failed  Int @default(0)

  status      String    @default("running") // running | success | partial | failed
  errors      String?
  details     String? // JSON kết quả theo từng loại dữ liệu
  startedAt   DateTime  @default(now())
  // Dấu "còn sống" đóng liên tục trong lúc chạy. Thiếu nó thì đợt chạy nền chết
  // giữa chừng vẫn hiện "đang chạy" mãi mãi, không ai biết nên chờ hay bấm lại.
  heartbeatAt DateTime?
  // Số lần watchdog đã tự chạy tiếp sau khi đứt (Cloud Run thay máy mỗi lần
  // deploy). Chạm trần thì dừng, đừng quay vòng ăn hết hạn mức API.
  attempts    Int       @default(0)
  finishedAt  DateTime?

  @@index([mode])
  @@index([status])
  @@index([startedAt])
}

// ─── Cổng đồng bộ MISA AMIS Kế toán ────────────────────────────────────────
// Kéo DANH MỤC (đối tượng, vật tư, kho, ĐVT) và TỒN KHO từ MISA ACT Open API.
// Chứng từ KHÔNG kéo được — MISA chỉ có hàm đẩy lên (xem services/misa.ts).

model MisaConfig {
  id             String  @id @default("default")
  appId          String
  accessCode     String
  orgCompanyCode String
  baseUrl        String? // để trống = https://actapp.misa.vn

  enabled      Boolean @default(false)
  syncProducts Boolean @default(true)
  syncPartners Boolean @default(true) // khách hàng + NCC (MISA gộp chung)
  syncStocks   Boolean @default(true) // danh mục kho
  syncBalance  Boolean @default(false) // tồn kho — đụng tồn thật nên mặc định TẮT

  overwriteNames  Boolean @default(false)
  overwritePrices Boolean @default(false)
  overwriteStock  Boolean @default(false)

  defaultCategoryId  String?
  defaultWarehouseId String?

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MisaMap {
  id       String   @id @default(cuid())
  entity   String // product | customer | supplier | warehouse
  misaId   String
  misaCode String?
  localId  String
  syncedAt DateTime @default(now())

  @@unique([entity, misaId])
  @@index([entity, localId])
  @@index([misaCode])
}

model MisaSyncLog {
  id       String    @id @default(cuid())
  entity   String
  mode     String    @default("manual")
  dryRun   Boolean   @default(false)
  fromDate DateTime?

  fetched Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  skipped Int @default(0)
  failed  Int @default(0)

  status      String    @default("running")
  errors      String?
  details     String?
  startedAt   DateTime  @default(now())
  heartbeatAt DateTime?
  attempts    Int       @default(0)
  finishedAt  DateTime?

  @@index([mode])
  @@index([status])
  @@index([startedAt])
}
